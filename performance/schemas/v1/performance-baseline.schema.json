{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p11.pm/schemas/performance-baseline.v1.json",
  "title": "P11 PM performance baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "baselineVersion",
    "baselineId",
    "contractVersion",
    "observedAt",
    "releaseReadiness",
    "source",
    "measurements",
    "unknowns"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/v1/performance-baseline.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "baselineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "baselineId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseReadiness": {
      "enum": [
        "go",
        "conditional",
        "no-go"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "cleanWorkingTree",
        "description"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "cleanWorkingTree": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "evidenceLevel",
        "value",
        "unit"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidenceLevel": {
          "enum": [
            "measured",
            "modeled",
            "unverified"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            "=",
            ">=",
            ">"
          ]
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 1
        },
        "approximate": {
          "type": "boolean"
        }
      }
    }
  }
}
