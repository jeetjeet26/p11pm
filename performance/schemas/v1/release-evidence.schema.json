{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p11.pm/schemas/release-evidence.v1.json",
  "title": "P11 PM immutable release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceVersion",
    "evidenceId",
    "generatedAt",
    "environment",
    "overallStatus",
    "contract",
    "source",
    "deployment",
    "migrations",
    "checks",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "https://p11.pm/schemas/release-evidence.v1.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "ci",
        "preview",
        "staging",
        "production-candidate",
        "production"
      ]
    },
    "overallStatus": {
      "$ref": "#/$defs/status"
    },
    "contract": {
      "$ref": "#/$defs/versionedFile"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "cleanWorkingTree",
        "packageLockSha256"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "cleanWorkingTree": {
          "type": "boolean"
        },
        "packageLockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "id",
        "region",
        "rollbackTarget"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollbackTarget": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionedFile"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_:][a-z0-9]+)*$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "pass",
        "fail",
        "not-run"
      ]
    },
    "versionedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
